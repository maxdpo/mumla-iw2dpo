<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- IW2DPO: KEYLOCK screen, auto = only radios with touch screen (default off) -->
    <ListPreference
        android:defaultValue="off"
        android:entries="@array/keylockModeNames_iw2dpo"
        android:entryValues="@array/keylockModeValues_iw2dpo"
        android:key="keylock_mode"
        android:title="@string/keylock_mode_iw2dpo"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />

    <!-- IW2DPO: KEYLOCK unlock code, 4 digits (default 1234) -->
    <EditTextPreference
        android:defaultValue="1234"
        android:key="keylock_code"
        android:title="@string/keylock_code_iw2dpo"
        android:summary="@string/keylock_code_sum_iw2dpo"
        android:dialogMessage="@string/keylock_code_dialog_iw2dpo"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="chatNotify"
        android:summary="@string/chatNotificationsSum"
        android:title="@string/chatNotifications"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:key="stay_awake"
        android:defaultValue="false"
        android:title="@string/stay_awake"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="useTts"
        android:summary="@string/useTtsSum"
        android:title="@string/useTts"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="shortTtsMessages"
        android:summary="@string/shortTtsMessagesSum"
        android:title="@string/shortTtsMessages"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="load_images"
        android:summary="@string/loadImagesSum"
        android:title="@string/loadImages"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="autoReconnect"
        android:summary="@string/autoReconnectSum"
        android:title="@string/autoReconnect"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="forceTcp"
        android:summary="@string/forceTcpSum"
        android:title="@string/forceTcp"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="useTor"
        android:summary="@string/useTorSum"
        android:title="@string/useTor"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:defaultValue="false"
        android:key="startUpInPinnedMode"
        android:summary="@string/pref_start_upIn_pinned_mode_sum"
        android:title="@string/pref_start_up_in_pinned_mode"
        app:iconSpaceReserved="false" />

    <!-- IW2DPO: automatic connect/reconnect to whichever server was last used
         successfully (tracked automatically, no server picker needed here). -->
    <CheckBoxPreference
        android:defaultValue="true"
        android:key="autoconnect_enabled"
        android:title="@string/autoconnectEnabled"
        android:summary="@string/autoconnectEnabledSum"
        app:iconSpaceReserved="false" />
</PreferenceScreen>
